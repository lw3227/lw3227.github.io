    {
      "para_index": 5,
      "text": "\u7535\u6c14\u5de5\u7a0b\u7855\u58eb | GPA\uff1a4.0/4.0\t\u9884\u8ba1 2026 \u5e74 12 \u6708\u6bd5\u4e1a",
