    },
    {
      "para_index": 6,
      "text": "\u4e2d\u5c71\u5927\u5b66\t\u5e7f\u5dde\uff0c\u4e2d\u56fd",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u5fae\u7535\u5b50\u79d1\u5b66\u4e0e\u5de5\u7a0b\u5b66\u58eb | GPA\uff1a3.7/4.0\t2025 \u5e74 6 \u6708\u6bd5\u4e1a",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u8363\u8a89\uff1a\u4e2d\u5c71\u5927\u5b66\u5956\u5b66\u91d1\uff1b\u672c\u79d1\u4f18\u79c0\u6bd5\u4e1a\u8bba\u6587\u5956",
      "style": "Normal"
    },
    {
      "para_index": 9,
      "text": "\u5b9e\u4e60\u7ecf\u5386",
      "style": "Normal"
    },
    {
      "para_index": 10,
      "text": "\u96bc\u77bb\u79d1\u6280\t\u4e0a\u6d77\u5f20\u6c5f\uff0c\u4e2d\u56fd",
      "style": "Normal"
    },
    {
      "para_index": 11,
      "text": "CPU IP \u8bbe\u8ba1\u5b9e\u4e60\u751f\t2026 \u5e74 6 \u6708 - 2026 \u5e74 9 \u6708",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "\u7ca4\u82af\u534a\u5bfc\u4f53\t\u5e7f\u5dde\uff0c\u4e2d\u56fd",
      "style": "Normal"
    },
    {
      "para_index": 18,
      "text": "TCAD / \u5668\u4ef6\u5de5\u7a0b\u5b9e\u4e60\u751f\t2024 \u5e74 7 \u6708 - 2024 \u5e74 9 \u6708",
      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "\u9879\u76ee\u7ecf\u5386",
      "style": "Normal"
    },
    {
      "para_index": 22,
      "text": "Apple \u8d5e\u52a9\u624b\u52bf\u8bc6\u522b CNN \u52a0\u901f\u5668 ASIC\t2026 \u5e74 2 \u6708 - \u81f3\u4eca",
      "style": "Normal"
    },
    {
      "para_index": 26,
      "text": "\u57fa\u4e8e P6 \u5fae\u67b6\u6784\u7684\u4e71\u5e8f\u6267\u884c RISC-V \u5904\u7406\u5668\t2026 \u5e74 3 \u6708 - 2026 \u5e74 6 \u6708",
      "style": "Normal"
    },
    {
      "para_index": 31,
      "text": "N-Body \u786c\u4ef6\u52a0\u901f\u5668\u5f62\u5f0f\u9a8c\u8bc1\t2025 \u5e74 10 \u6708 - 2025 \u5e74 12 \u6708",
      "style": "Normal"
    },
    {
      "para_index": 34,
      "text": "64-tap 16-bit FIR \u6570\u5b57\u6ee4\u6ce2\u5668\t2025 \u5e74 10 \u6708 - 2025 \u5e74 12 \u6708",
      "style": "Normal"
    },
    {
      "para_index": 37,
      "text": "\u6280\u80fd",
      "style": "Normal"
    },
    {
      "para_index": 39,
      "text": "\u7f16\u7a0b\uff1aVerilog\u3001SystemVerilog\u3001Python\uff08NumPy\u3001PyTorch\uff09\u3001C\u3001MATLAB",
      "style": "Normal"
    },
    {
