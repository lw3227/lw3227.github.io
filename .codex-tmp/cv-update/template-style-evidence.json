      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "RD\u90e8\u95e8 TCAD\u7ec4 \u5b9e\u4e60\t2024\u5e747\u6708 \u2013 2024\u5e749\u6708",
      "style": "Normal"
    },
    {
      "para_index": 25,
      "text": "\u9879\u76ee\u7ecf\u5386",
      "style": "Normal"
    },
    {
      "para_index": 26,
      "text": "Apple\u8d5e\u52a9\u6d41\u7247\u9879\u76ee\uff1a\u9762\u5411\u624b\u52bf\u8bc6\u522b\u7684Systolic-Array-Based CNN \u52a0\u901f\u5668\uff08\u5df2\u4e8e7\u6708\u6295\u7247\uff09\t2026\u5e742\u6708 \u2013 \u81f3\u4eca",
      "style": "Normal"
    },
    {
      "para_index": 32,
      "text": "\u57fa\u4e8e P6 \u5fae\u67b6\u6784\u7684\u8d85\u6807\u91cf\u4e71\u5e8f\u6267\u884c\uff08Out-of-Order\uff09RISC-V \u5904\u7406\u5668\t2026\u5e743\u6708-2026\u5e746\u6708",
      "style": "Normal"
